#!/bin/sh
if [ -n "${FAKE_TERN_LOG:-}" ]; then
	printf '%s\n' "$*" >>"$FAKE_TERN_LOG"
fi
verb=${1:-}
if [ -n "${FAKE_TERN_FAIL:-}" ] && [ "$verb" = "$FAKE_TERN_FAIL" ]; then
	echo "fake tern: $verb failed" >&2
	exit 1
fi
case "$verb" in
ls)
	exec cat "$FAKE_TERN_DIR/ls.json"
	;;
process)
	if [ -f "$FAKE_TERN_DIR/process-$2.json" ]; then
		exec cat "$FAKE_TERN_DIR/process-$2.json"
	fi
	printf '{"pane":%s,"child":{"pid":61321,"name":"zsh","argv":["/bin/zsh","-l"],"cwd":"/tmp"},"group":61321,"foreground":{"pid":61321,"name":"zsh","argv":["/bin/zsh","-l"],"cwd":"/tmp"}}\n' "$2"
	;;
new)
	echo '{"block":42}'
	;;
wait)
	exit "${FAKE_TERN_WAIT_STATUS:-0}"
	;;
close)
	if [ -n "${FAKE_TERN_GONE_BEFORE_CLOSE:-}" ] && [ -e "$FAKE_TERN_GONE_BEFORE_CLOSE" ]; then
		echo "fake tern: close while $FAKE_TERN_GONE_BEFORE_CLOSE exists" >&2
		exit 1
	fi
	;;
esac
exit 0
