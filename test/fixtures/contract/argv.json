{
  "branches": ["branches", "--repo", "{{repo}}"],
  "branches-offline": ["branches", "--repo", "{{repo}}", "--offline"],
  "clone": ["clone", "{{nameWithOwner}}"],
  "config": ["config"],
  "create-branch": ["create", "--repo", "{{repo}}", "--no-tab", "--branch={{branch}}"],
  "create-branch-new": ["create", "--repo", "{{repo}}", "--no-tab", "--branch={{branch}}", "--new"],
  "create-branch-relocate": ["create", "--repo", "{{repo}}", "--no-tab", "--branch={{branch}}", "--relocate"],
  "create-pr": ["create", "--repo", "{{repo}}", "--no-tab", "--pr", "{{pr}}"],
  "issue-ref": ["issue-ref", "--", "{{text}}"],
  "issue-suggest": ["create", "--issue", "{{issue}}", "--no-tab", "--suggest", "--repo", "{{repo}}"],
  "issue-suggest-no-repo": ["create", "--issue", "{{issue}}", "--no-tab", "--suggest"],
  "issue-create": ["create", "--repo", "{{repo}}", "--no-tab", "--issue", "{{issue}}"],
  "issue-create-no-repo": ["create", "--no-tab", "--issue", "{{issue}}"],
  "issue-create-relocate": ["create", "--repo", "{{repo}}", "--no-tab", "--issue", "{{issue}}", "--relocate"],
  "issue-edited-create": ["create", "--repo", "{{repo}}", "--no-tab", "--issue", "{{issue}}", "--branch={{branch}}"],
  "issue-branch-create": ["create", "--repo", "{{repo}}", "--no-tab", "--branch={{branch}}", "--issue", "{{issue}}"],
  "list": ["list"],
  "list-all": ["list", "--all"],
  "new-repo": ["new-repo", "{{nameWithOwner}}", "--visibility", "{{visibility}}"],
  "remove": ["remove", "{{worktree}}"],
  "remove-close-busy-tabs": ["remove", "{{worktree}}", "--close-busy-tabs"],
  "remove-force": ["remove", "{{worktree}}", "--force"],
  "remove-force-close-busy-tabs": ["remove", "{{worktree}}", "--force", "--close-busy-tabs"],
  "remove-keep-tab": ["remove", "{{worktree}}", "--keep-tab"],
  "remove-keep-tab-force": ["remove", "{{worktree}}", "--keep-tab", "--force"],
  "repos": ["repos"],
  "resolve": ["resolve", "{{dir}}"],
  "setup": ["setup"]
}
